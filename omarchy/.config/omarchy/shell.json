{
  "bar": {
    "background": "opaque",
    "id": "omarchy.bar",
    "layout": {
      "center": [
        {
          "clock": {
            "format": "HH:mm",
            "formatAlt": "ddd d MMM HH:mm"
          },
          "dateFormat": "ddd d MMM",
          "id": "mridul.tide-clock"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "id": "mridul.tide-islands"
        },
        {
          "id": "mridul.tide-menu"
        },
        {
          "id": "mridul.tide-workspaces"
        },
        {
          "id": "mridul.tide-window",
          "maxWidth": 380
        }
      ],
      "right": [
        {
          "foldAfter": 0,
          "id": "mridul.tide-host",
          "key": "deadbeat",
          "pinIf": "item.summary && item.summary.attention > 0",
          "widgetSource": "../io.github.themridul.deadbeat/Panel.qml"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "RemoteSession"
          ]
        },
        {
          "id": "mridul.tide-host",
          "key": "agents",
          "showIf": "item.alarming === true",
          "widgetSource": "../mridul.agents/Panel.qml"
        },
        {
          "foldAfter": 0,
          "id": "mridul.tide-host",
          "key": "fleet",
          "showIf": "item.alert === true",
          "widget": {
            "onlyWhenTrouble": true
          },
          "widgetSource": "../io.github.niraj-envision.fleet/BarWidget.qml"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "mridul.tide-host",
          "key": "tailscale",
          "showIf": "String(item.iconColor) === String(item.foreground)",
          "widgetSource": "../mridul.tailscale/Panel.qml"
        },
        {
          "id": "mridul.tide-host",
          "key": "vpn",
          "widget": {
            "onlyWhenActive": true
          },
          "widgetSource": "../mridul.iiitd-vpn/BarWidget.qml"
        },
        {
          "id": "mridul.tide-host",
          "key": "f1",
          "showIf": "label !== \"\" && (!/(\\d+)d\\b/.test(label) || parseInt(/(\\d+)d\\b/.exec(label)[1], 10) <= 3)",
          "widgetSource": "../com.leafbox.f1/BarWidget.qml"
        },
        {
          "id": "mridul.tide-vitals"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "cloneSourceRestores": [
    "shmall.lock",
    "mridul.osd"
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.osd"
  ],
  "dock": {
    "pinned": [
      "org.gnome.Nautilus",
      "foot",
      "omacalc",
      "omawrite",
      "YouTube"
    ]
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "mridul.osd"
    },
    {
      "id": "mridul.tide-round"
    },
    {
      "id": "shmall.lock"
    },
    {
      "id": "zzwong.stage"
    }
  ],
  "version": 1
}
