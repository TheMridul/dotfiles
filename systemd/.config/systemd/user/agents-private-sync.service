[Unit]
Description=Commit and push private agent memory (~/.agents)
After=network-online.target
Wants=network-online.target
OnFailure=agents-private-sync-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/.agents
ExecStart=/usr/bin/bash -c 'git add -A && { git diff --cached --quiet || git commit -q -m "Sync agent memory"; } && git push -q'
